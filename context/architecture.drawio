      <mxCell id="card_src" value="&lt;b&gt;Facts&lt;/b&gt;&lt;br&gt;4 CSV drops a day, D+1&lt;br&gt;Manifest row count&lt;br&gt;Fixed header contract&lt;br&gt;Sales delta; others full" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeWidth=1.5;fontColor=#143642;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=#37474F;" vertex="1" parent="1">
        <mxGeometry x="60" y="900" width="270" height="210" as="geometry" />
      </mxCell>
      <mxCell id="card_brz" value="&lt;b&gt;Format&lt;/b&gt; CSV as landed&lt;br&gt;&lt;b&gt;Partition&lt;/b&gt; ingest_dt&lt;br&gt;&lt;b&gt;Retention&lt;/b&gt; 400 days&lt;br&gt;&lt;b&gt;Guarantees&lt;/b&gt; byte-for-byte, replayable, no transformation&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; types, keys, dedupe" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeWidth=1.5;fontColor=#143642;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=#8B4513;" vertex="1" parent="1">
        <mxGeometry x="470" y="900" width="270" height="210" as="geometry" />
      </mxCell>
      <mxCell id="card_slv" value="&lt;b&gt;Format&lt;/b&gt; Parquet&lt;br&gt;&lt;b&gt;Partition&lt;/b&gt; sale_dt / snapshot_dt&lt;br&gt;&lt;b&gt;Retention&lt;/b&gt; 3 yrs (quarantine 90 d)&lt;br&gt;&lt;b&gt;Guarantees&lt;/b&gt; typed, deduped, bad rows quarantined&lt;br&gt;&lt;b&gt;Compares&lt;/b&gt; against TGT to find new / changed rows&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; surrogate keys, SCD2, totals" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeWidth=1.5;fontColor=#143642;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=#546E7A;" vertex="1" parent="1">
        <mxGeometry x="880" y="900" width="290" height="210" as="geometry" />
      </mxCell>
      <mxCell id="card_gold" value="&lt;b&gt;Format&lt;/b&gt; Snowflake tables  ·  &lt;b&gt;Partition&lt;/b&gt; (clustering) FCT_SALES DAY_KY, FCT_INVENTORY SNAPSHOT_DT, others none&lt;br&gt;&lt;b&gt;Load&lt;/b&gt; dims: SCD1/SCD2 merge · facts: insert / merge · DIM_DAY: seed  ·  &lt;b&gt;Retention&lt;/b&gt; 7 years&lt;br&gt;&lt;b&gt;Guarantees&lt;/b&gt; 2.1 grain, SCD rules, every FK resolves (G7)&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; real-time (data as of D+1), raw evidence" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeWidth=1.5;fontColor=#143642;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=#B8860B;" vertex="1" parent="1">
        <mxGeometry x="1310" y="900" width="720" height="210" as="geometry" />
      </mxCell>
      <mxCell id="card_mrt" value="&lt;b&gt;Format&lt;/b&gt; table + view&lt;br&gt;&lt;b&gt;Partition&lt;/b&gt; DAY_KY&lt;br&gt;&lt;b&gt;Load&lt;/b&gt; recompute touched days&lt;br&gt;&lt;b&gt;Retention&lt;/b&gt; 3 yrs, rebuilt from TGT&lt;br&gt;&lt;b&gt;Guarantees&lt;/b&gt; totals = FCT_SALES (G9)&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; line detail" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeWidth=1.5;fontColor=#143642;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=#8D6E00;" vertex="1" parent="1">
        <mxGeometry x="2170" y="900" width="280" height="210" as="geometry" />
      </mxCell>
      <mxCell id="card_con" value="&lt;b&gt;Reads&lt;/b&gt;&lt;br&gt;Aggregate for reports&lt;br&gt;TGT for detail and history&lt;br&gt;Never STG / TMP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeWidth=1.5;fontColor=#143642;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=#6A1B9A;" vertex="1" parent="1">
        <mxGeometry x="2590" y="900" width="220" height="210" as="geometry" />
      </mxCell>
      <mxCell id="p_gates" value="&lt;b style='font-size:17px'&gt;Quality gates&lt;/b&gt; (boundary · rule · action)&lt;br&gt;&lt;br&gt;&lt;b&gt;G1&lt;/b&gt; Source→STG · file by SLA, row count = manifest · &lt;i&gt;alert, then fail&lt;/i&gt;&lt;br&gt;&lt;b&gt;G2&lt;/b&gt; Source→STG · header matches contract · &lt;i&gt;quarantine file&lt;/i&gt;&lt;br&gt;&lt;b&gt;G3&lt;/b&gt; STG→TMP · business keys not null · &lt;i&gt;quarantine row&lt;/i&gt;&lt;br&gt;&lt;b&gt;G4&lt;/b&gt; STG→TMP · (TRANSACTION_ID, LINE_NUM) unique · &lt;i&gt;keep latest, quarantine rest&lt;/i&gt;&lt;br&gt;&lt;b&gt;G5&lt;/b&gt; STG→TMP · sale date within D-7..D · &lt;i&gt;quarantine row&lt;/i&gt;&lt;br&gt;&lt;b&gt;G6&lt;/b&gt; STG→TMP · net = sales − discount · &lt;i&gt;quarantine&lt;/i&gt; (reserved &amp;gt; on hand: &lt;i&gt;alert&lt;/i&gt;)&lt;br&gt;&lt;b&gt;G7&lt;/b&gt; TMP→TGT · item and location resolve to a key · &lt;i&gt;quarantine + alert&lt;/i&gt;&lt;br&gt;&lt;b&gt;G8&lt;/b&gt; TMP→TGT · inventory rows within ±20% of prior day · &lt;i&gt;fail&lt;/i&gt;&lt;br&gt;&lt;b&gt;G9&lt;/b&gt; TGT→Aggregate · AGG totals = FCT_SALES per day · &lt;i&gt;fail&lt;/i&gt;&lt;br&gt;&lt;b&gt;G10&lt;/b&gt; TGT · no overlapping price periods · &lt;i&gt;fail&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fontColor=#143642;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;strokeWidth=2;fillColor=#FFF5F5;strokeColor=#B85450;" vertex="1" parent="1">
        <mxGeometry x="40" y="1190" width="860" height="300" as="geometry" />
      </mxCell>
      <mxCell id="p_reload" value="&lt;b style='font-size:17px'&gt;Reload one bad day D&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Land corrected file under &lt;b&gt;ingest_dt=D&lt;/b&gt;; keep the bad one (superseded)&lt;br&gt;2. Overwrite the TMP (Silver) partitions from that ingest&lt;br&gt;3. &lt;b&gt;FCT_SALES&lt;/b&gt; merge on (TRANSACTION_ID, LINE_NUM); recompute &lt;b&gt;AGG&lt;/b&gt; for touched DAY_KY&lt;br&gt;4. &lt;b&gt;FCT_INVENTORY&lt;/b&gt; delete + insert SNAPSHOT_DT = D&lt;br&gt;5. &lt;b&gt;FCT_PRICE&lt;/b&gt; re-derive periods from D for changed pairs&lt;br&gt;6. &lt;b&gt;SCD2 dims&lt;/b&gt; undo versions opened/closed on D, re-apply&lt;br&gt;7. Re-run G7–G10, then publish. Every step is idempotent." style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fontColor=#143642;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;strokeWidth=2;fillColor=#FFF8E1;strokeColor=#D6B656;" vertex="1" parent="1">
        <mxGeometry x="940" y="1190" width="700" height="300" as="geometry" />
      </mxCell>
      <mxCell id="p_dep" value="&lt;b style='font-size:17px'&gt;Departure from the reference&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;DIM_DAY&lt;/b&gt; is seeded straight into Gold (green dashed line).&lt;br&gt;&lt;br&gt;It is generated (DAY_KY = YYYYMMDD), has no source system and nothing raw to keep or clean. Two extra copies would add no audit value. The generator and seed file are version controlled." style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fontColor=#143642;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;strokeWidth=2;fillColor=#ECF8E5;strokeColor=#82B366;" vertex="1" parent="1">
        <mxGeometry x="1680" y="1190" width="480" height="300" as="geometry" />
      </mxCell>
      <mxCell id="p_legend" value="&lt;b style='font-size:17px'&gt;Legend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fontColor=#143642;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#143642;" vertex="1" parent="1">
        <mxGeometry x="2200" y="1190" width="530" height="300" as="geometry" />
      </mxCell>
      <mxCell id="lg_doc" value="" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=2;fontColor=#143642;fontSize=12;" vertex="1" parent="1">
        <mxGeometry x="2220" y="1240" width="50" height="40" as="geometry" />
