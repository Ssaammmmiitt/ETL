        <mxCell id="lane_src" value="&lt;font style='font-size:26px'&gt;&lt;b&gt;1. SOURCE FILES&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;Four daily drops&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=120;fillColor=#37474F;swimlaneFillColor=#ECEFF1;strokeColor=#37474F;strokeWidth=3;fontColor=#FFFFFF;rounded=1;arcSize=2;collapsible=0;container=1;verticalAlign=middle;" vertex="1" parent="1">
