        <mxCell id="p_ret_r7_c1" value="1 day B/S, 7 days Gold" style="shape=partialRectangle;connectable=0;fillColor=#FFFFFF;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontColor=#143642;fontSize=13;" vertex="1" parent="p_ret_r7">
