        <mxCell id="src_item" value="&lt;b style='font-size:16px'&gt;item_master_YYYYMMDD.csv&lt;/b&gt;&lt;br&gt;&lt;br&gt;Item &amp;gt; subcategory &amp;gt; category &amp;gt; department&lt;br&gt;Daily full extract" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=24;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=2;fontColor=#143642;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="lane_src">
