        <mxGeometry x="2280" y="1240" width="190" height="40" as="geometry" />
      </mxCell>
      <mxCell id="lg_cyl" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;strokeWidth=2;fontSize=12;fontColor=#143642;fillColor=#FFFFFF;strokeColor=#607D8B;" vertex="1" parent="1">
        <mxGeometry x="2480" y="1240" width="50" height="40" as="geometry" />
