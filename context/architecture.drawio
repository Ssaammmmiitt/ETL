          <mxGeometry x="40" y="1789" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="src_seed" value="&lt;b style='font-size:16px'&gt;seed_dim_day.csv&lt;/b&gt;&lt;br&gt;&lt;br&gt;Generated calendar (DAY_KY = YYYYMMDD)&lt;br&gt;CSV | none | seed&lt;br&gt;&lt;b&gt;Departure:&lt;/b&gt; loaded straight to Gold" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=24;fillColor=#ECF8E5;strokeColor=#82B366;strokeWidth=2;fontColor=#143642;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="lane_src">
          <mxGeometry x="40" y="2510" width="400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="mrt_vw" value="&lt;b style=font-size:16px&gt;VW_DAILY_ITEM_LOCN_SALES&lt;/b&gt;&lt;br&gt;View over FCT_SALES, same grain as the aggregate&lt;br&gt;(view, not a stored table)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#176B7A;fontColor=#143642;fontSize=13;arcSize=8;" vertex="1" parent="lane_mrt">
          <mxGeometry x="105" y="1100" width="510" height="110" as="geometry" />
        </mxCell>
        <mxCell id="mrt_rep" value="&lt;b style=font-size:16px&gt;Report packs&lt;/b&gt;&lt;br&gt;Store daily sales, weekly category and region totals,&lt;br&gt;all summed from AGG_DAILY_ITEM_LOCN_SALES" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#176B7A;fontColor=#143642;fontSize=13;arcSize=8;" vertex="1" parent="lane_mrt">
          <mxGeometry x="105" y="860" width="510" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mrt_contract" value="&lt;b&gt;Aggregate contract&lt;/b&gt;&lt;br&gt;Guarantees: totals reconcile with FCT_SALES per DAY_KY (gate G9).&lt;br&gt;Rebuildable from TGT at any time.&lt;br&gt;Does not guarantee: transaction line detail." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#176B7A;fontColor=#143642;fontSize=15;align=left;spacingLeft=12;arcSize=6;" vertex="1" parent="lane_mrt">
          <mxGeometry x="105" y="2510" width="510" height="160" as="geometry" />
        </mxCell>
        <mxCell id="con_bi" value="&lt;b style='font-size:16px'&gt;BI dashboards&lt;/b&gt;&lt;br&gt;Store and item sales, daily and weekly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A1B9A;strokeWidth=2;fontColor=#143642;fontSize=13;arcSize=12;" vertex="1" parent="lane_con">
          <mxGeometry x="60" y="420" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="con_fin" value="&lt;b style='font-size:16px'&gt;Finance&lt;/b&gt;&lt;br&gt;Net sales, tax and discount reporting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A1B9A;strokeWidth=2;fontColor=#143642;fontSize=13;arcSize=12;" vertex="1" parent="lane_con">
          <mxGeometry x="60" y="700" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="con_merch" value="&lt;b style='font-size:16px'&gt;Merchandising and pricing&lt;/b&gt;&lt;br&gt;Price history and promo analysis (FCT_PRICE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A1B9A;strokeWidth=2;fontColor=#143642;fontSize=13;arcSize=12;" vertex="1" parent="lane_con">
          <mxGeometry x="60" y="980" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="con_ds" value="&lt;b style='font-size:16px'&gt;Data science&lt;/b&gt;&lt;br&gt;Demand and stock models (Gold facts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A1B9A;strokeWidth=2;fontColor=#143642;fontSize=13;arcSize=12;" vertex="1" parent="lane_con">
          <mxGeometry x="60" y="1260" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="src_contract" value="&lt;b&gt;Drop contract&lt;/b&gt;&lt;br&gt;One file per drop per day, named *_YYYYMMDD.csv.&lt;br&gt;Arrives with a manifest row count.&lt;br&gt;Header must match the agreed schema." style="rounded=1;whiteSpace=wrap;html=1;fontColor=#143642;fontSize=17;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;arcSize=4;fillColor=#FFFFFF;strokeColor=#37474F;" vertex="1" parent="lane_src">
          <mxGeometry x="40" y="2280" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="gold_contract" value="&lt;b style='font-size:16px'&gt;Gold contract&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Guarantees:&lt;/b&gt; the 2.1 star-schema grain; SCD1 and SCD2 rules from model_notes.md; every fact foreign key resolves to a dimension key (gate G7); facts are idempotent on (TRANSACTION_ID, LINE_NUM), (ITEM_KY, LOCN_KY, SNAPSHOT_DT) and (ITEM_KY, LOCN_KY, EFFECTIVE_START_DT).&lt;br&gt;&lt;br&gt;&lt;b&gt;Does not guarantee:&lt;/b&gt; real-time freshness (data is as of D+1); raw evidence of what the source sent (that is Bronze).&lt;br&gt;&lt;br&gt;&lt;b&gt;Partitioning:&lt;/b&gt; FCT_SALES by DAY_KY, FCT_INVENTORY by SNAPSHOT_DT. FCT_PRICE and all dimensions are not partitioned, because a price period or SCD2 version spans many dates." style="rounded=1;whiteSpace=wrap;html=1;fontColor=#143642;fontSize=17;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;arcSize=4;fillColor=#FFFFFF;strokeColor=#B8860B;strokeWidth=2;" vertex="1" parent="lane_gold">
          <mxGeometry x="120" y="1120" width="1920" height="300" as="geometry" />
        </mxCell>
        <mxCell id="gold_reload" value="&lt;b style='font-size:16px'&gt;Reload of one bad day D in Gold&lt;/b&gt;&lt;br&gt;&lt;br&gt;FCT_SALES: merge on (TRANSACTION_ID, LINE_NUM), then recompute AGG for the DAY_KY values touched.&lt;br&gt;FCT_INVENTORY: delete and insert WHERE SNAPSHOT_DT = D (one clustered partition).&lt;br&gt;FCT_PRICE: re-derive price periods from snapshot D onward for the item and location pairs that changed.&lt;br&gt;SCD2 dims: undo versions opened or closed on D, then re-apply the corrected master file.&lt;br&gt;Re-run gates G7 to G10 before publishing. Every step is safe to re-run." style="rounded=1;whiteSpace=wrap;html=1;fontColor=#143642;fontSize=17;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;arcSize=4;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" vertex="1" parent="lane_gold">
          <mxGeometry x="120" y="1560" width="1920" height="260" as="geometry" />
        </mxCell>
        <mxCell id="g12" value="&lt;b style='font-size:18px'&gt;G1, G2&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;SLA + row count: alert, then fail&lt;br&gt;Schema: quarantine file&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.12;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontColor=#143642;" vertex="1" parent="1">
          <mxGeometry x="545.0" y="40" width="210" height="160" as="geometry" />
        </mxCell>
        <mxCell id="g36" value="&lt;b style='font-size:18px'&gt;G3 to G6&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;Null keys, duplicates,&lt;br&gt;date window, net amount:&lt;br&gt;quarantine row&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.12;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontColor=#143642;" vertex="1" parent="1">
          <mxGeometry x="1445.0" y="40" width="210" height="160" as="geometry" />
        </mxCell>
        <mxCell id="g78" value="&lt;b style='font-size:18px'&gt;G7, G8&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;FK resolves: quarantine + alert&lt;br&gt;Inventory +/-20%: fail&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.12;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontColor=#143642;" vertex="1" parent="1">
          <mxGeometry x="2405.0" y="40" width="210" height="160" as="geometry" />
        </mxCell>
        <mxCell id="g910" value="&lt;b style='font-size:18px'&gt;G9, G10&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;AGG = FCT totals: fail&lt;br&gt;No price overlap: fail&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.12;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontColor=#143642;" vertex="1" parent="1">
          <mxGeometry x="6695.0" y="40" width="210" height="160" as="geometry" />
        </mxCell>
        <mxCell id="title" value="&lt;b&gt;Costco Retail DW: Medallion Architecture&lt;/b&gt;" style="text;html=1;fontSize=40;fontColor=#143642;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-150" width="2400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Assignment 2.2. The 14 tables from Costco.drawio (10 DIM + 3 FCT as Gold TGT; 1 AGG as Gold Aggregate). Table types follow STG (Bronze), TMP (Silver), TGT and Aggregate (Gold) appear exactly once. Badges above each table show format | partitioning | load pattern. Red hexagons are quality gates on each layer boundary." style="text;html=1;fontSize=18;fontColor=#455A64;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
